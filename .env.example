# BambooHR Configuration
BAMBOOHR_DOMAIN=your-company-subdomain
BAMBOOHR_API_KEY=your-api-key-here

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Filter by specific job
JOB_ID=

# Optional: Path to requirements file (defaults to job_requirements.md)
REQUIREMENTS_FILE=job_requirements.md
